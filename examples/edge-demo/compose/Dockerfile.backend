# syntax=docker/dockerfile:1.7
# Backend binary build: simple multi-stage without cargo-chef.
# Builder and runtime share bookworm for glibc compatibility.

FROM rust:1-bookworm AS builder
WORKDIR /app
COPY . .
RUN cargo build --release -p ferryman-edge-demo --bin backend

FROM gcr.io/distroless/cc-debian12
WORKDIR /app
COPY --from=builder /app/target/release/backend /usr/local/bin/backend
ENTRYPOINT ["/usr/local/bin/backend"]
